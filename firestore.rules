rules_version = '2';

// Regras do Firestore do CRM ēloSites.
// Somente o UID do proprietário pode ler ou escrever. Todo o resto é negado.
//
// UID do proprietário (Firebase Console > Authentication > Users). O UID não é segredo.
// Este arquivo espelha as regras publicadas no console; se mudar aqui, publique lá também.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.uid == 'BI9afYasZoQgC2G6dxqo6sU6w7P2';
    }

    match /clients/{clientId} {
      allow read, write: if isOwner();
    }

    // Qualquer outra coleção: acesso negado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
